# Dépendances
node_modules/

# Configuration locale : contient la clé CAVVA → JAMAIS committée
config.json

# Secret dont dérive la signature des briefs. Écrit par
# outils/injecter-secret.js, embarqué à l'empaquetage, JAMAIS versionné : ce
# dépôt est public, et un secret versionné n'est plus un secret.
src/main/brief-secret.js

# Build / distribution
dist/
out/

# Exports SIA téléchargés pour le développement : volumineux, et l'utilisateur
# final télécharge les siens sur le site du SIA (rien n'est redistribué).
donnees-sia/

# Signature du brief d'exemple : régénérée par `npm run brief:signer`, elle
# changerait à chaque retouche du fichier signé.
outils/briefs-exemple.json.sig

# Divers OS / éditeurs
.DS_Store
Thumbs.db
*.log
